{
  "name": "@signaltree/enterprise",
  "version": "14.0.0-rc.1",
  "description": "DEPRECATED \u2014 use tree.updateAndReport() in @signaltree/core instead. The diff engine is measurably slower than the core API that replaced it.",
  "license": "BUSL-1.1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./diff-engine": {
      "types": "./src/lib/diff-engine.d.ts",
      "import": "./dist/lib/diff-engine.js",
      "default": "./dist/lib/diff-engine.js"
    },
    "./path-index": {
      "types": "./src/lib/path-index.d.ts",
      "import": "./dist/lib/path-index.js",
      "default": "./dist/lib/path-index.js"
    },
    "./update-engine": {
      "types": "./src/lib/update-engine.d.ts",
      "import": "./dist/lib/update-engine.js",
      "default": "./dist/lib/update-engine.js"
    },
    "./enterprise-enhancer": {
      "types": "./src/lib/enterprise-enhancer.d.ts",
      "import": "./dist/lib/enterprise-enhancer.js",
      "default": "./dist/lib/enterprise-enhancer.js"
    }
  },
  "keywords": [
    "angular",
    "signals",
    "state-management",
    "enterprise",
    "performance",
    "optimization",
    "bulk-updates",
    "diff",
    "monitoring"
  ],
  "author": "Jonathan D Borgia",
  "homepage": "https://github.com/JBorgia/signaltree/tree/main/packages/enterprise#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JBorgia/signaltree.git",
    "directory": "packages/enterprise"
  },
  "bugs": {
    "url": "https://github.com/JBorgia/signaltree/issues"
  },
  "peerDependencies": {
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@signaltree/core": "workspace:*",
    "tslib": "^2.0.0"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@signaltree/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "src/**/*.d.ts",
    "skills/**/*",
    "README.md"
  ]
}
